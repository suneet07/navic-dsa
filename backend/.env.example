# Copy to backend/.env and adjust. Every value is optional.
PORT=5000
NODE_ENV=development

# MongoDB (local or Atlas). Leave empty to run without a database:
# place search then uses data/generated/places.json and route history is disabled.
MONGO_URI=mongodb://127.0.0.1:27017/navic

# Browser origins allowed to call the API (Vite dev server by default).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=180

# C++ engine (paths are relative to the project root)
# ENGINE_PATH=dsa/build/navic-engine.exe
# GRAPH_PATH=data/generated/graph.txt
FLOYD_MAX_NODES=1500
ENGINE_TIMEOUT_MS=30000

# Worldwide providers (free, no key)
PHOTON_BASE_URL=https://photon.komoot.io
OSRM_BASE_URL=https://routing.openstreetmap.de
