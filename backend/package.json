{
  "name": "navic-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Express + MongoDB API for Navic. Routing is delegated to the C++ engine in ../dsa.",
  "type": "module",
  "main": "src/server.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "prepare-data": "node scripts/prepare-data.js",
    "seed": "node scripts/seed-places.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "mongoose": "^8.9.0",
    "morgan": "^1.10.0"
  }
}
